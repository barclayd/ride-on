{
  "name": "ride-on-api",
  "account_id": "3343118697a4beccae42090c4520cd29",
  "main": "src/index.ts",
  "workers_dev": true,
  "routes": [{ "pattern": "api.ride-on.cc", "custom_domain": true }],
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  // Non-commercial prototype confirmed by Dan; use "off" to disable new requests.
  "vars": {
    "STRAVA_ENABLED": "true",
    "STRAVA_IMPORT_ENABLED": "true",
    "GROUND_EVIDENCE_MODE": "non-commercial",
    "RIDE_MONITORING": "enabled",
    "RIDE_LEARNING_WEATHER_MODE": "non-commercial"
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "queues": {
    "producers": [
      { "binding": "RIDE_MONITOR_QUEUE", "queue": "ride-monitoring" }
    ],
    "consumers": [
      {
        "queue": "ride-monitoring",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "ride-monitoring-failed"
      }
    ]
  },
  "services": [
    {
      "binding": "STRAVA_STITCH",
      "service": "strava-stitch",
      "entrypoint": "RideOnStrava"
    }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "secrets": {
    "required": [
      "MET_OFFICE_API_KEY",
      "MET_OFFICE_BPF_API_KEY",
      "APPLE_WEATHER_CONFIG_JSON",
      "AUTH_CONFIG_JSON"
    ]
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 5000
  },

  "d1_databases": [
    {
      "binding": "ROUTES_DB",
      "database_name": "ride-on-routes",
      "database_id": "bb9fd337-a5c9-4005-8d72-6157a9f3bbbf",
      // Keep existing local routes and profiles in their original local database.
      "preview_database_id": "ROUTES_DB",
      "migrations_dir": "migrations"
    }
  ],
  // Reuse the existing development namespace; new weather entries have their own prefix.
  "kv_namespaces": [
    {
      "binding": "WEATHER_CACHE",
      "id": "2a198dd680b1461ca0c0010d0dbce05c"
    }
  ]
}
