{
  "name": "ride-on-api",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:session": "bun scripts/create-local-session.ts",
    "deploy": "wrangler deploy",
    "check": "bun run types && bun run lint && bun run test",
    "types": "tsgo --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun run test:unit && bun run test:integration",
    "test:watch": "bun test --watch ./test",
    "migrate:local": "wrangler d1 migrations apply ROUTES_DB --local",
    "migrate:remote": "wrangler d1 migrations apply ROUTES_DB --remote",
    "build:check": "wrangler deploy --dry-run",
    "bindings": "wrangler types src/env.d.ts --include-runtime false",
    "test:unit": "bun test ./test",
    "test:integration": "node --test integration/*.test.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@js-temporal/polyfill": "0.5.1",
    "better-auth": "1.7.7",
    "hono": "^4.12.27",
    "jose": "6.2.12",
    "saxes": "6.0.0",
    "suncalc": "^2.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/workers-types": "5.20261009.1",
    "@levischuck/tiny-cbor": "0.2.11",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260703.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "msw": "3.0.2",
    "typescript": "^6.0.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24"
  }
}
