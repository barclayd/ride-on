{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ride-on-landing",
  "account_id": "3343118697a4beccae42090c4520cd29",
  "main": "src/worker.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "ride-on.cc", "custom_domain": true },
    { "pattern": "www.ride-on.cc", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-09",
  // astro build writes the static site here. The worker runs first only to send www to the apex.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
