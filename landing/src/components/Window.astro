---
import WindowCard from './WindowCard';
---

<section class="section" data-rv>
  <div class="wrap split window-split">
    <WindowCard client:visible />
    <div class="copy">
      <div class="eyebrow">Your window</div>
      <h2 class="h2">See which day wins.</h2>
      <p class="lede">
        Tomorrow, this weekend, the next five days, or your own dates. Ride in daylight or set your own hours.
      </p>
    </div>
  </div>
</section>
