---
import Footer from '../components/Footer.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Off route · Ride On" noindex>
  <main class="section lost">
    <div class="wrap lost-inner">
      <div class="eyebrow">404</div>
      <h1 class="h2">Off route.</h1>
      <p class="lede">There's nothing at this address. The ride starts back home.</p>
      <a class="button" href="/">Back to Ride On</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .lost {
    min-height: 70vh;
    align-items: center;
  }

  .lost-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
</style>
