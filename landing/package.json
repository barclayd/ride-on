{
  "name": "ride-on-landing",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run map && astro dev",
    "build": "bun run map && astro build",
    "preview": "astro preview",
    "map": "bun scripts/copy-map.ts",
    "routes": "bun scripts/extract-routes.ts",
    "og": "bun scripts/og.ts",
    "check": "bun run types && bun run lint",
    "types": "astro check",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test:e2e": "playwright test",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.4",
    "maplibre-gl": "6.16.0",
    "motion": "14.7.1",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.3",
    "@cloudflare/workers-types": "5.20261028.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.155.0"
  }
}
