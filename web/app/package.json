{
  "name": "ride-on-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun run build && wrangler dev",
    "dev:session": "bun scripts/dev-session.ts",
    "deploy": "bun run build && wrangler deploy",
    "check": "bun run types && bun run lint && bun run test",
    "types": "tsgo --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test ./src",
    "build:check": "bun run build && wrangler deploy --dry-run",
    "bindings": "wrangler types src/env.d.ts --include-runtime false"
  },
  "dependencies": {
    "lucide-static": "0.469.0",
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "remix": "3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260703.1",
    "typescript": "^6.0.3",
    "wrangler": "4.149.0"
  }
}
