<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets ASWebAuthenticationSession finish API sign-in on https://api.ride-on.cc/auth/browser/done. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:api.ride-on.cc</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.danbarclay.rideon</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- CloudKit silent pushes so remote SwiftData changes arrive while the
	     app runs, not just on next launch. Distribution signing rewrites
	     this to `production`. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- Shares the widget's snapshot and map stills with the widget extension (WidgetStore). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.danbarclay.rideon</string>
	</array>
</dict>
</plist>
